# Configuration du frontend (variables lues par Vite). AUCUN secret : un client public n'en a pas.
# Copiez en `.env.local` pour surcharger (ignoré par Git).
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=shiku
VITE_KEYCLOAK_CLIENT_ID=shiku-web
# URL de base de l'API. En développement : /api (proxy Vite vers APP_PORT, évite CORS).
# En production : l'URL publique de l'API ou un reverse proxy de même origine.
VITE_API_BASE_URL=/api
