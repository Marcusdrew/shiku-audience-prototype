# MODÈLE de configuration locale. Ce fichier est versionné : il ne contient AUCUN secret.
# Les valeurs vides sont générées au hasard par `bash scripts/init-local.sh`,
# qui écrit le résultat dans `.env` (ignoré par Git, jamais commité).
# Staging et Production auront leurs propres secrets, jamais dans ce dépôt (DEC-10).

# --- Réglages non secrets ---
POSTGRES_SUPERUSER=postgres
POSTGRES_DB=shiku
KEYCLOAK_ADMIN=kcadmin
APP_PORT=3000
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432
# Vérification des jetons par le backend (étape 1). Déjà câblé dans docker-compose.yml pour le
# conteneur `app` ; ne servent ici que pour lancer le backend HORS Docker. Aucun secret.
#   KEYCLOAK_ISSUER   = adresse du realm vue par le navigateur (revendication `iss` des jetons)
#   KEYCLOAK_JWKS_URL = adresse où le backend lit les clés publiques (facultatif, déduit de l'émetteur)
#   AUTH_CLIENT_ID    = client attendu dans le jeton (revendication `azp`), défaut shiku-web
# KEYCLOAK_ISSUER=http://localhost:8080/realms/shiku
# AUTH_CLIENT_ID=shiku-web

# --- Secrets locaux : laisser vides, init-local.sh les remplit ---
POSTGRES_SUPERUSER_PASSWORD=
# Rôles de base séparés (infra/postgres/01-roles.sh)
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
DB_PURGE_PASSWORD=
DB_AUDIT_PASSWORD=
DB_KEYCLOAK_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# Secret du compte de service Keycloak « shiku-service » (placeholder ${KC_SERVICE_PASSWORD} du realm)
KC_SERVICE_PASSWORD=
# Comptes de test fictifs du realm (infra/keycloak/realm-shiku.json, placeholders ${KC_PASSWORD_*})
KC_PASSWORD_RECEPTION=
KC_PASSWORD_ASSISTANT1=
KC_PASSWORD_ASSISTANT2=
KC_PASSWORD_AUTHORITY=
KC_PASSWORD_ADMIN=
